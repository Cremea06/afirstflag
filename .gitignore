# Ignore temporary / system files
error_log
*.log
.DS_Store
Thumbs.db

# Optional: ignore the backups folder if you don’t want it in Git
'Backups and troubleshooting'/

# CHG-060: Rust build output (the shipped .wasm lives in /engine/)
wasm-src/rust/target/

# CHG-072: click speed record store, created on the server by api/click-record.php (never commit)
data/click-record.json
data/click-record-hits.json
data/click-record-salt.php
data/click-record-salt.php.*.tmp

# CHG-076: Python byte-code from running tools/geo-build/build.py
__pycache__/

# CHG-077: countries seen so far, created on the server by api/geo-country.php (never commit; delete to reset the count)
data/countries-visited.json
data/countries-visited.json.tmp
data/countries-visited.lock

# CHG-082: visit counter limit and lock files, created on the server by api/live-stats.php (never commit).
# data/live-stats.json itself stays tracked as before: never commit a change to it, or `git pull` on the host stops.
data/live-stats-hits.json
data/live-stats-hits.json.tmp
data/live-stats-salt.php
data/live-stats-salt.php.tmp
data/live-stats.lock
data/live-stats.json.tmp
data/live-stats.json.bad
